SITE_URL=http://localhost:3000
NEXT_PUBLIC_PROCESSOR_URL=http://127.0.0.1:8787
# Public base used in completed-job video links. In production, set all three
# public URLs to the same https://your-hostname value.
PUBLIC_BASE_URL=http://127.0.0.1:8787
LOCAL_WEB_PORT=3001
LOCAL_PROCESSOR_PORT=8787
LOCAL_DATA_DIR=./local-data
VIDEO_ANALYSIS_PROVIDER=gemini
VIDEO_INTELLIGENCE_ENABLED=true
VIDEO_INTELLIGENCE_LOCATION=us-east1
VIDEO_INTELLIGENCE_FEATURES=SHOT_CHANGE_DETECTION,OBJECT_TRACKING,TEXT_DETECTION
# Add SPEECH_TRANSCRIPTION when the commentary language is known.
VIDEO_INTELLIGENCE_SPEECH_LANGUAGE=en-US
VIDEO_INTELLIGENCE_TIMEOUT_MS=120000
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
GEMINI_MINIMUM_INTERVAL_MS=0
GEMINI_QUOTA_BASE_DELAY_MS=60000
GEMINI_QUOTA_MAXIMUM_DELAY_MS=300000
GEMINI_REQUEST_TIMEOUT_MS=180000
MATCH_RESEARCH_ENABLED=true
ANALYSIS_CHUNK_SECONDS=180
ANALYSIS_PROXY_CONCURRENCY=3
ANALYSIS_FPS=3
ANALYSIS_HEIGHT=480
SOCCERNET_CALF_ENABLED=true
SOCCERNET_CALF_PYTHON=./.venv-soccernet/Scripts/python.exe
SOCCERNET_CALF_SCRIPT=./local-processor/soccernet-calf.py
SOCCERNET_CALF_REPO=./tools/external/soccernet-sn-spotting
TRACKING_PYTHON=./.venv-tracking/Scripts/python.exe
TRACKING_SCRIPT=./local-processor/track-football-v2.py
TRACKING_MODEL=./tools/tracking/yolo11n.pt
TRACKING_BALL_MODEL=./tools/tracking/yolo-football-ball-detection.pt
TRACKING_PITCH_MODEL=./tools/tracking/yolo-football-pitch-detection.pt
TRACKING_SAMPLE_FPS=10
TRACKING_SCENE_CONCURRENCY=2
TRACKING_IMAGE_SIZE=960
TRACKING_BALL_IMAGE_SIZE=1280
# Faster validation profile used only when the final edit stays native 16:9.
NATIVE_TRACKING_SAMPLE_FPS=8
NATIVE_TRACKING_IMAGE_SIZE=800
NATIVE_TRACKING_BALL_IMAGE_SIZE=1280
TRACKING_CONFIDENCE=0.08
TRACKING_BALL_CONFIDENCE=0.03
TTS_PROVIDER=google_cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
TTS_MODEL=gemini-2.5-pro-tts
TTS_LANGUAGE=en-US
TTS_VOICE=Fenrir
CAPTION_FONT_PATH=C:/Windows/Fonts/arialbd.ttf
FFMPEG_PATH=./tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=./tools/ffmpeg/bin/ffprobe.exe
BRAND_WATERMARK_PATH=./assets/channels4_profile.jpg
