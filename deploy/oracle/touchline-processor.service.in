[Unit]
Description=Touchline AI football processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_ROOT__
Environment=NODE_ENV=production
ExecStart=/usr/bin/node local-processor/server.mjs
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
