FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TRACKING_PYTHON=/opt/venv/bin/python

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg fonts-dejavu-core fonts-liberation python3 python3-venv python3-pip \
      libglib2.0-0 libgl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel typing-extensions \
    && /opt/venv/bin/pip install --index-url https://download.pytorch.org/whl/cpu torch torchvision \
    && /opt/venv/bin/pip install ultralytics==8.4.63 supervision==0.30.2 lap==0.5.12 scipy==1.15.3 osqp==1.0.4 scenedetect==0.7.1 mplsoccer==1.8.0 demucs==4.0.1 yt-dlp yt-dlp-ejs \
    && /opt/venv/bin/python -c "from ultralytics.trackers.track_tracker import TRACKTRACK; from ultralytics.trackers.bot_sort import BOTSORT; from ultralytics.trackers.byte_tracker import BYTETracker"

COPY local-processor ./local-processor
COPY assets ./assets
COPY tools/tracking ./tools/tracking
COPY deploy/cloud-run/worker.mjs ./deploy/cloud-run/worker.mjs
COPY deploy/cloud-run/checkpoint-store.mjs ./deploy/cloud-run/checkpoint-store.mjs
COPY deploy/cloud-run/job-status-policy.mjs ./deploy/cloud-run/job-status-policy.mjs
COPY deploy/cloud-run/source-import-policy.mjs ./deploy/cloud-run/source-import-policy.mjs
COPY deploy/cloud-run/processor-startup-smoke.mjs ./deploy/cloud-run/processor-startup-smoke.mjs

RUN cd /app/local-processor \
    && /opt/venv/bin/python -c "from football_detection import PersonTracker; tracker = PersonTracker(sample_fps=10, method='tracktrack'); assert tracker.active_method == 'tracktrack'"

RUN node deploy/cloud-run/processor-startup-smoke.mjs

CMD ["node", "deploy/cloud-run/worker.mjs"]
