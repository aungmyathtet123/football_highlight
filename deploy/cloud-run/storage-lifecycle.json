{
  "rule": [
    {
      "action": { "type": "Delete" },
      "condition": { "age": 3, "matchesPrefix": ["uploads/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 14, "matchesPrefix": ["outputs/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "age": 3, "matchesPrefix": ["checkpoints/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "daysSinceCustomTime": 1, "matchesPrefix": ["uploads/"] }
    },
    {
      "action": { "type": "Delete" },
      "condition": { "daysSinceCustomTime": 7, "matchesPrefix": ["outputs/"] }
    }
  ]
}
