{
  "name": "touchline-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "processor": "node local-processor/server.mjs",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "setup:tracking": "powershell -ExecutionPolicy Bypass -File scripts/setup-tracking.ps1",
    "setup:soccernet": "powershell -ExecutionPolicy Bypass -File scripts/setup-soccernet.ps1",
    "setup:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-setup.ps1",
    "local:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "test:gemini": "node scripts/test-gemini.mjs",
    "test:gemini-video": "node scripts/test-gemini-video.mjs",
    "test:video-intelligence": "node scripts/test-video-intelligence.mjs",
    "test:tts": "node scripts/test-google-cloud-tts.mjs",
    "test:connections": "npm run test:gemini && npm run test:gemini-video && npm run test:video-intelligence && npm run test:tts",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/editorial-policy.test.mjs tests/payoff-evidence.test.mjs tests/tracked-position.test.mjs tests/hold-pan-camera.test.mjs tests/pipeline-state.test.mjs tests/action-boundaries.test.mjs tests/viral-reel-policy.test.mjs tests/delivery-policy.test.mjs tests/passage-inventory.test.mjs tests/native-frame-action.test.mjs tests/score-normalization.test.mjs tests/gemini-request-scheduler.test.mjs tests/serialized-json-store.test.mjs tests/bounded-concurrency.test.mjs tests/render-style.test.mjs tests/deployment.test.mjs tests/youtube-publisher.test.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "test:tracking": ".venv-tracking\\Scripts\\python.exe -m unittest discover -s tests -p *_test.py",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .venv-soccernet --ignore-pattern tools/external",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^7.0.0",
    "@google-cloud/video-intelligence": "^7.0.0",
    "@google/genai": "^2.18.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
